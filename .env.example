# .env.example – copy to .env.local and fill in your values
# NEVER commit .env.local to version control

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://internationalStudent62012:internationalStudent62012@ankit95087.lj3hvtg.mongodb.net/


# NextAuth secret – generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-here

# App URL (use http://localhost:3000 for local dev)
NEXTAUTH_URL=http://localhost:3000

# LLM API key (used ONLY server-side in api/chat route)
LLM_API_KEY=your-llm-api-key-here

# OpenStreetMap User-Agent identification (required by Overpass and Nominatim usage policies)
OSM_USER_AGENT="CampusCompass/1.0 (campuscompass@sample.test)"

